      "statements": {
        "subtitle": {
          "text": "Erwerbslose in % der Erwerbspersonen (15–74 Jahre).\nJahreswerte 2016–2025, beide Geschlechter.",
          "source_ids": [
            "eurostat-une-rt-a"
          ]
        },
        "note": {
          "text": "Reihenbrüche: Dänemark 2016/17/23, Deutschland 2020.\nLinien an den betroffenen Übergängen unterbrochen.",
          "source_ids": [
            "eurostat-une-rt-a"
          ]
        },
        "alt_text": {
          "text": "Liniendiagramm der jährlichen Erwerbslosenquote für 15- bis 74-Jährige in Deutschland, der Schweiz, Dänemark und Norwegen, 2016–2025. In allen vier Ländern steigen die Quoten 2024 und 2025. Die Endwerte 2025 sind Deutschland 3,8 %, Schweiz 4,9 %, Dänemark 6,4 % und Norwegen 4,5 %. Die y-Achse reicht von 0 bis 8 %. Punkte zeigen Jahreswerte. Die gestrichelte Linie kennzeichnet Norwegen. Eurostat-Reihenbrüche unterbrechen die Linien in Dänemark 2017 und 2023 sowie in Deutschland 2020; auch der erste dänische Wert 2016 ist als Reihenbruch markiert. Quelle: Eurostat une_rt_a.",
          "source_ids": [
            "eurostat-une-rt-a"
          ]
        },
        "end_label_heading": {
          "text": "2025",
          "source_ids": [
            "eurostat-une-rt-a"
          ]
        }
      }
